// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MODERATOR
  USER
  // "Гость" — НЕ значение этого enum, а отсутствие валидной сессии/JWT.
  // Не добавлять GUEST сюда — см. streamer.API#15 / steramer.io#1.
}

model User {
  id        String   @id @default(cuid())
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile?
  settings     Settings?
  gameAccounts GameAccount[]
  socialLinks  SocialLink[]
  authMethods  AuthMethod[]
  newsLikes    NewsLike[]
  newsViews    NewsView[]
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  name      String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuthMethodType {
  LOCAL
  GOOGLE
}

model AuthMethod {
  id           String         @id @default(cuid())
  userId       String
  type         AuthMethodType
  identifier   String // login для LOCAL, googleId для GOOGLE
  passwordHash String? // только для LOCAL
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, identifier])
}

model GameAccount {
  id         String   @id @default(cuid())
  userId     String
  nickname   String
  externalId String // id аккаунта в игре, не путать с id этой строки
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SocialLinkType {
  EMAIL
  TELEGRAM
  TIKTOK
  PHONE
  VIBER
}

model SocialLink {
  id        String         @id @default(cuid())
  userId    String
  type      SocialLinkType
  value     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Theme {
  LIGHT
  DARK
  SYSTEM // "как на устройстве" — тема подстраивается под системную настройку клиента
}

model Settings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  theme                Theme   @default(SYSTEM)
  receiveNotifications Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Schedule {
  id         String  @id @default(cuid())
  weekday    Weekday @unique
  isOnline   Boolean @default(false)
  eventTitle String?
  time       String?
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  publishedAt DateTime @default(now())
  viewCount   Int      @default(0)
  hasNoImage  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images      NewsImage[]
  tags        NewsTag[]
  likes       NewsLike[]
  views       NewsView[]
  pinnedSlots PinnedNewsSlot[]
}

model NewsImage {
  id        String   @id @default(cuid())
  newsId    String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
}

model NewsTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  textColor String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news News[]
}

model NewsLike {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
}

model NewsView {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
}

enum PinnedGridViewport {
  SMALL
  MIDDLE
  LARGE
}

enum CardImagePosition {
  TOP
  RIGHT
  BOTTOM
  LEFT
}

model PinnedGridLayout {
  id        String             @id @default(cuid())
  viewport  PinnedGridViewport @unique
  columns   Int
  rows      Int
  updatedAt DateTime           @updatedAt

  slots PinnedNewsSlot[]
}

model PinnedNewsSlot {
  id       String @id @default(cuid())
  layoutId String
  newsId   String

  colStart Int
  rowStart Int
  colSpan  Int
  rowSpan  Int

  imagePosition    CardImagePosition @default(TOP)
  imageSizePercent Int               @default(50)
  imageScale       Float             @default(1)
  imageOffsetX     Int               @default(50)
  imageOffsetY     Int               @default(50)
  backgroundColor  String            @default("#f9f9f9")
  textColor        String            @default("#1e1e1e")
  coverImageUrl    String?

  createdAt DateTime @default(now())

  layout PinnedGridLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  news   News             @relation(fields: [newsId], references: [id], onDelete: Cascade)
}

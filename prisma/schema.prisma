// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  MODERATOR
  USER
  // "Гость" — НЕ значение этого enum, а отсутствие валидной сессии/JWT.
  // Не добавлять GUEST сюда — см. streamer.API#15 / steramer.io#1.
}

model User {
  id        String   @id @default(cuid())
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile?
  settings     Settings?
  gameAccounts GameAccount[]
  socialLinks  SocialLink[]
  authMethods  AuthMethod[]
  newsLikes    NewsLike[]
  newsViews    NewsView[]
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  name      String?
  avatarUrl String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AuthMethodType {
  LOCAL
  GOOGLE
}

model AuthMethod {
  id           String         @id @default(cuid())
  userId       String
  type         AuthMethodType
  identifier   String // login для LOCAL, googleId для GOOGLE
  passwordHash String? // только для LOCAL
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, identifier])
}

model GameAccount {
  id         String   @id @default(cuid())
  userId     String
  nickname   String
  externalId String // id аккаунта в игре, не путать с id этой строки
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SocialLinkType {
  EMAIL
  TELEGRAM
  TIKTOK
  PHONE
  VIBER
}

model SocialLink {
  id        String         @id @default(cuid())
  userId    String
  type      SocialLinkType
  value     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Theme {
  LIGHT
  DARK
  SYSTEM // "как на устройстве" — тема подстраивается под системную настройку клиента
}

model Settings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  theme                Theme   @default(SYSTEM)
  receiveNotifications Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Schedule {
  id         String  @id @default(cuid())
  weekday    Weekday @unique
  isOnline   Boolean @default(false)
  eventTitle String?
  time       String?
}

// Состояние обложки новости: явное, а не выводимое из наличия картинок
// (streamer.API#80, ОБЛ-Б-01). NONE — осознанно без обложки; IMAGE — одна из
// картинок набора (адресуется по url: набор пересоздаётся при каждой правке,
// id не переживают её); CUSTOM — своя, в набор не входит.
enum NewsCoverType {
  NONE
  IMAGE
  CUSTOM
}

model News {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  publishedAt DateTime @default(now())
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Обложка новости (streamer.API#80). coverUrl всегда локальный /uploads/*:
  // внешняя ссылка скачивается при приёме и дальше не хранится (ОБЛ-Б-02).
  // Фокус здесь — только для CUSTOM; у IMAGE он живёт на самой NewsImage.
  coverType   NewsCoverType @default(NONE)
  coverUrl    String?
  coverFocalX Int?
  coverFocalY Int?

  images     NewsImage[]
  tags       NewsTag[]
  likes      NewsLike[]
  views      NewsView[]
  pinnedNews PinnedNews?

  // Лента всегда сортируется по publishedAt, а отбор по периоду публикации
  // (streamer.API#77, ФИЛ-О-02) добавляет к этому диапазонное условие —
  // без индекса это полный проход по архиву на каждую порцию.
  @@index([publishedAt])
}

model NewsImage {
  id        String   @id @default(cuid())
  newsId    String
  url       String
  order     Int      @default(0)
  // Точка фокуса картинки в процентах (0..100), для object-position на фронте.
  // Nullable намеренно: null = центр (50/50) по умолчанию, фокус задаётся
  // только там, где нужно (сейчас — обложки закреплённых новостей), не для
  // всех картинок подряд (streamer.API#73).
  focalX    Int?
  focalY    Int?
  createdAt DateTime @default(now())

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)
}

model NewsTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String
  textColor String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  news News[]
}

model NewsLike {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
}

model NewsView {
  id        String   @id @default(cuid())
  userId    String
  newsId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId])
}

// SMALL — телефон и планшет книжкой; LARGE — планшет альбомом, ноутбук,
// десктоп. Какая раскладка применяется на каком экране (в т.ч. ориентация)
// решает фронт, бэк просто хранит две раскладки (streamer.API#73).
enum PinnedGridViewport {
  SMALL
  LARGE
}

enum CardImagePosition {
  TOP
  RIGHT
  BOTTOM
  LEFT
}

model PinnedGridLayout {
  id        String             @id @default(cuid())
  viewport  PinnedGridViewport @unique
  columns   Int
  rows      Int
  updatedAt DateTime           @updatedAt

  placements PinnedPlacement[]
}

// ЧТО закреплено + КАК выглядит, один раз на новость — независимо от
// раскладки (streamer.API#73, заменяет прежний PinnedNewsSlot, который
// дублировал стиль на каждую раскладку и расходился между ними).
model PinnedNews {
  id               String            @id @default(cuid())
  newsId           String            @unique
  imagePosition    CardImagePosition @default(TOP)
  imageSizePercent Int               @default(50)
  backgroundColor  String            @default("#f9f9f9")
  textColor        String            @default("#1e1e1e")
  createdAt        DateTime          @default(now())

  news       News              @relation(fields: [newsId], references: [id], onDelete: Cascade)
  placements PinnedPlacement[]
}

// ГДЕ лежит закреплённая новость — своё на каждую раскладку.
model PinnedPlacement {
  id           String @id @default(cuid())
  pinnedNewsId String
  layoutId     String

  colStart Int
  rowStart Int
  colSpan  Int
  rowSpan  Int

  pinnedNews PinnedNews       @relation(fields: [pinnedNewsId], references: [id], onDelete: Cascade)
  layout     PinnedGridLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([pinnedNewsId, layoutId])
}
